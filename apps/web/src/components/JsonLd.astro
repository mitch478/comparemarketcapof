---
/** Emits one JSON-LD script. `<` is escaped so a `</script>` in data can't break out. */
interface Props { data: Record<string, unknown> | Array<Record<string, unknown>> }
const { data } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
