---
/** Copy link, share to X, download the OG card. */
interface Props { url: string; text: string; image?: string | undefined; imageName?: string | undefined }
const { url, text, image, imageName = 'comparemarketcapof.png' } = Astro.props;
const x = `https://twitter.com/intent/tweet?${new URLSearchParams({ text: `${text} ${url}` }).toString()}`;
---
<div class="flex flex-wrap gap-4 font-ui" data-share>
  <button type="button" class="btn btn-primary brutal" data-copy={url}>Copy link</button>
  <a class="btn btn-primary brutal" href={x} target="_blank" rel="noopener noreferrer">Share to X</a>
  {image && <a class="btn btn-primary brutal" href={image} download={imageName}>Download image</a>}
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = label), 1500);
    });
  });
</script>
