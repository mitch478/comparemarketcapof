---
import type { Asset } from '@cmc/core';
import { formatCap, formatPrice, formatSupply } from '@cmc/core';
import AssetLogo from './AssetLogo.astro';
import { hubPath } from '../lib/routes';

interface Props { assets: Asset[] }
const { assets } = Astro.props;
---
<div class="flex flex-col gap-6">
  {assets.map((c) => (
    <section aria-label={`${c.name} stats`} class="flex items-start gap-3">
      <a href={hubPath(c.slug)} class="shrink-0" aria-label={`${c.name} market cap page`}>
        <AssetLogo src={c.image} name={c.name} size={41} />
      </a>
      <div class="w-full">
        <h3 class="font-ui text-ui font-semibold">
          <a href={hubPath(c.slug)} class="underline decoration-2 underline-offset-4">{c.name}</a>
          <span> · {c.symbol} · #{c.rank}</span>
        </h3>
        <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-2">
          <div>
            <dt class="font-ui text-sm uppercase">Price</dt>
            <dd class="num font-bold text-base">{formatPrice(c.price)}</dd>
          </div>
          <div class="text-right">
            <dt class="font-ui text-sm uppercase">Market cap</dt>
            <dd class="num font-bold text-base">{formatCap(c.marketCap)}</dd>
          </div>
          <div class="col-span-2">
            <dt class="font-ui text-sm uppercase">Circulating supply</dt>
            <dd class="num font-bold text-base">{formatSupply(c.circulatingSupply, c.symbol)}</dd>
          </div>
        </dl>
      </div>
    </section>
  ))}
</div>
