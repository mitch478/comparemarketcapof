---
/**
 * Static design mock for approval. Hard-coded SOL → BTC numbers, no KV, no data layer.
 * Everything visual here is the reference for Phase 2; the numbers are not.
 * Built on DaisyUI primitives (btn, card, dropdown, menu) with the neo-brutalist overrides.
 */
import Base from '../../layouts/Base.astro';
import { formatCap, formatMultiplier, formatPrice, formatSupply, formatUtcTime } from '@cmc/core';

const a = {
  name: 'Solana', symbol: 'SOL', rank: 5,
  image: 'https://coin-images.coingecko.com/coins/images/4128/large/solana.png',
  price: 142.18, marketCap: 77_200_000_000, circulatingSupply: 543_000_000, totalSupply: 610_000_000,
};
const b = {
  name: 'Bitcoin', symbol: 'BTC', rank: 1,
  image: 'https://coin-images.coingecko.com/coins/images/1/large/bitcoin.png',
  price: 67_412, marketCap: 1_334_000_000_000, circulatingSupply: 19_740_000, totalSupply: 21_000_000,
};
const top = [
  { rank: 1, symbol: 'BTC', name: 'Bitcoin', cap: 1_334_000_000_000, image: b.image },
  { rank: 2, symbol: 'ETH', name: 'Ethereum', cap: 412_000_000_000, image: 'https://coin-images.coingecko.com/coins/images/279/large/ethereum.png' },
  { rank: 3, symbol: 'USDT', name: 'Tether', cap: 118_000_000_000, image: 'https://coin-images.coingecko.com/coins/images/325/large/Tether.png' },
  { rank: 4, symbol: 'BNB', name: 'BNB', cap: 84_000_000_000, image: 'https://coin-images.coingecko.com/coins/images/825/large/bnb-icon2_2x.png' },
  { rank: 5, symbol: 'SOL', name: 'Solana', cap: 77_200_000_000, image: a.image },
];

const impliedPrice = b.marketCap / a.circulatingSupply;
const multiplier = b.marketCap / a.marketCap;
const bFdv = b.price * b.totalSupply;
const impliedFdvPrice = bFdv / a.totalSupply;
const verb = multiplier >= 1 ? 'would be worth' : 'would drop to';
const updatedAt = '2026-09-15T07:05:00.000Z';

const title = `${a.name} at ${b.name}'s market cap: ${formatPrice(impliedPrice)} (${formatMultiplier(multiplier)}) | comparemarketcapof`;
---
<Base title={title}>
  <h1 class="font-display text-h1 mt-10 leading-tight">
    {a.name} with the market cap of {b.name}
  </h1>

  <!-- Compare card -->
  <section
    aria-label="Comparison"
    class="card mt-8 bg-primary text-primary-content border-2 border-neutral shadow-card"
  >
    <div class="card-body px-6 pt-8 pb-8">
      <div class="flex flex-col items-stretch">
        <!-- Picker A: DaisyUI dropdown shown open as the design reference for the Phase 2 combobox -->
        <div class="dropdown dropdown-open w-full">
          <button type="button" class="btn btn-primary btn-lg brutal w-full justify-start gap-3 font-ui text-ui tracking-[1px]" aria-haspopup="listbox" aria-expanded="true">
            <img src={a.image} alt="" width="28" height="28" class="logo" loading="eager" />
            {a.symbol}
            <span aria-hidden="true" class="ml-auto">▾</span>
          </button>
          <ul role="listbox" class="dropdown-content menu mt-2 w-full bg-base-100 text-base-content rounded-box border-2 border-neutral shadow-dropdown p-0 max-h-[264px] overflow-y-auto z-10">
            <li class="p-2"><input type="search" placeholder="Search 500 assets…" class="input input-bordered w-full font-ui" aria-label="Search assets" /></li>
            {top.map((c) => (
              <li>
                <a class="flex items-center gap-3 min-h-11 border-t border-base-300 rounded-none" href="#" role="option" aria-selected={c.symbol === a.symbol}>
                  <span class="num text-xs text-muted w-6">{c.rank}</span>
                  <img src={c.image} alt="" width="24" height="24" class="logo" loading="lazy" />
                  <span class="font-bold w-14">{c.symbol}</span>
                  <span class="text-muted flex-1 truncate">{c.name}</span>
                  <span class="num text-sm text-primary">{formatCap(c.cap)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="num font-bold text-[33px] text-neutral text-center my-4" aria-hidden="true">VS</div>

        <div class="dropdown w-full">
          <button type="button" class="btn btn-primary btn-lg brutal w-full justify-start gap-3 font-ui text-ui tracking-[1px]" aria-haspopup="listbox" aria-expanded="false">
            <img src={b.image} alt="" width="28" height="28" class="logo" loading="eager" />
            {b.symbol}
            <span aria-hidden="true" class="ml-auto">▾</span>
          </button>
        </div>
      </div>

      <p class="mt-9 text-center font-body font-bold text-base">
        If {a.symbol} reached {b.symbol}'s current market cap, one {a.symbol} {verb}
      </p>
      <p class="num mt-3 text-center font-body font-bold text-hero-mobile sm:text-hero text-accent break-words">
        {formatPrice(impliedPrice)}
      </p>
      <p class="num mt-2 text-center font-body text-lg">
        {formatMultiplier(multiplier)} today's price
      </p>
      <p class="mt-6 text-center font-ui text-sm opacity-80">
        Based on circulating supply. On fully diluted supply: <span class="num">{formatPrice(impliedFdvPrice)}</span>.
      </p>

      <!-- Stat rows -->
      <dl class="mt-10 flex flex-col gap-6">
        {[a, b].map((c) => (
          <div class="flex items-start gap-3">
            <img src={c.image} alt={`${c.name} logo`} width="41" height="41" class="logo logo-lg shrink-0" />
            <div class="grid grid-cols-2 gap-x-4 gap-y-2 w-full">
              <div>
                <dt class="font-ui text-ui uppercase opacity-80">Price</dt>
                <dd class="num font-bold text-base">{formatPrice(c.price)}</dd>
              </div>
              <div class="text-right">
                <dt class="font-ui text-ui uppercase opacity-80">Market cap</dt>
                <dd class="num font-bold text-base">{formatCap(c.marketCap)}</dd>
              </div>
              <div class="col-span-2">
                <dt class="font-ui text-ui uppercase opacity-80">Circulating supply</dt>
                <dd class="num font-bold text-base">{formatSupply(c.circulatingSupply, c.symbol)}</dd>
              </div>
            </div>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Share row -->
  <div class="mt-8 flex flex-wrap gap-4 font-ui">
    <button type="button" class="btn btn-primary brutal">Copy link</button>
    <a class="btn btn-primary brutal" href="#" rel="noopener">Share to X</a>
    <a class="btn btn-primary brutal" href="/og/dev.png" download>Download image</a>
  </div>

  <!-- <AffiliateSlot placement="comparison" /> renders nothing until a partner is configured -->

  <!-- Internal linking -->
  <nav aria-label="More comparisons" class="mt-12 flex flex-col gap-8 font-ui">
    <section>
      <h2 class="font-semibold text-lg">More comparisons for {a.name}</h2>
      <ul class="menu mt-2 p-0 w-full">
        {['Ethereum', 'Tether', 'BNB', 'XRP'].map((n) => (
          <li><a class="min-h-11 border-b border-base-300 rounded-none text-base underline" href="#">{a.name} with the market cap of {n}</a></li>
        ))}
      </ul>
    </section>
    <section>
      <h2 class="font-semibold text-lg">Other assets at {b.name}'s market cap</h2>
      <ul class="menu mt-2 p-0 w-full">
        {['Ethereum', 'Dogecoin', 'Cardano', 'Chainlink'].map((n) => (
          <li><a class="min-h-11 border-b border-base-300 rounded-none text-base underline" href="#">{n} with the market cap of {b.name}</a></li>
        ))}
      </ul>
    </section>
    <a class="btn btn-primary brutal self-start" href="#">Reverse: {b.name} at {a.name}'s market cap</a>
  </nav>

  <p class="num mt-10 font-ui text-xs text-muted">Data as of {formatUtcTime(updatedAt)} · dev mock, hard-coded numbers</p>
</Base>

<style>
  .logo { border-radius: 9999px; border: 2px solid var(--color-neutral); background: var(--color-base-100); }
  .logo-lg { width: 41px; height: 41px; }
  .brutal:active { transform: translate(3px, 3px); box-shadow: 3px 3px 0 var(--color-neutral); }
</style>
