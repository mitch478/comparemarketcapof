# ---- apps/cron (set with `wrangler secret put` in prod, or in apps/cron/.dev.vars locally) ----
# Shared secret required in the `x-refresh-secret` header for POST /refresh
REFRESH_SECRET=change-me
# Optional CoinGecko demo API key (free tier works without it, with lower rate limits)
COINGECKO_API_KEY=

# ---- apps/web (public, non-secret) ----
# Canonical site origin used for absolute URLs in SEO tags and sitemaps
PUBLIC_SITE_ORIGIN=https://comparemarketcapof.com
# Origin of the JSON API served by the cron Worker
PUBLIC_API_ORIGIN=https://api.comparemarketcapof.com
