# ---- apps/cron ----
# Secrets: `wrangler secret put <NAME>` in prod, or apps/cron/.dev.vars locally (gitignored).
# Required header value for POST /refresh
REFRESH_SECRET=change-me
# CoinGecko Demo API key (free: https://www.coingecko.com/en/developers/dashboard).
# REQUIRED in production: keyless requests from Cloudflare Workers are rate-limited (429) because
# the public quota is shared across all Workers egress IPs. Optional for local dev.
COINGECKO_API_KEY=
# Plain vars (set in apps/cron/wrangler.jsonc, listed here for reference):
#   SNAPSHOT_SOURCE=coingecko   ASSET_LIMIT=500 (raise to 2000 when ready)   MIN_ASSETS=100

# ---- apps/web (public, non-secret; set in apps/web/wrangler.jsonc) ----
PUBLIC_SITE_ORIGIN=https://comparemarketcapof.com
PUBLIC_API_ORIGIN=https://api.comparemarketcapof.com
